# Copy this file to .env and fill in real values. Never commit .env.

# Must point at the same database the Node backend uses.
MONGO_URI=mongodb://127.0.0.1:27017/warehouseDB

# Free key from https://positionstack.com — used to geocode delivery addresses.
POSITIONSTACK_API_KEY=

# Port the Flask service listens on (the backend's AI_SERVICE_URL must match).
PORT=5001
