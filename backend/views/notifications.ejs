<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main id="main-content">
  <div class="page-head">
    <div class="page-head__text">
      <h1 style="font-size: 1.75rem;">Notifications</h1>
      <p>
        <% if (unread > 0) { %>
          You have <strong><%= unread %></strong> unread alert<%= unread === 1 ? '' : 's' %>.
        <% } else { %>
          You are all caught up.
        <% } %>
      </p>
    </div>
    <% if (unread > 0) { %>
      <div class="page-head__actions">
        <form class="inline-form" action="/notifications/read-all" method="POST">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <button type="submit" class="btn btn-secondary">
            <i class="fa-solid fa-check-double" aria-hidden="true"></i> Mark all as read
          </button>
        </form>
      </div>
    <% } %>
  </div>

  <div class="toolbar">
    <div class="btn-group">
      <a class="btn btn-sm <%= filters.status === '' ? 'btn-primary' : 'btn-secondary' %>"
         href="/notifications">All</a>
      <a class="btn btn-sm <%= filters.status === 'unread' ? 'btn-primary' : 'btn-secondary' %>"
         href="/notifications?status=unread">Unread</a>
      <a class="btn btn-sm <%= filters.status === 'read' ? 'btn-primary' : 'btn-secondary' %>"
         href="/notifications?status=read">Read</a>
    </div>
  </div>

  <div class="table-container">
    <div class="table-scroll">
      <table class="responsive">
        <thead>
          <tr>
            <th scope="col">Date</th>
            <th scope="col">Message</th>
            <th scope="col">Status</th>
            <th scope="col">Action</th>
          </tr>
        </thead>
        <tbody>
          <% if (notifications.length === 0) { %>
            <tr>
              <td colspan="4">
                <div class="empty">
                  <div class="empty__icon"><i class="fa-solid fa-bell-slash" aria-hidden="true"></i></div>
                  <div class="empty__title">Nothing here</div>
                  <p>Low-stock alerts and system notices will show up on this page.</p>
                </div>
              </td>
            </tr>
          <% } else { %>
            <% notifications.forEach(notification => { %>
              <tr class="<%= notification.status === 'unread' ? 'row-warn' : '' %>">
                <td data-label="Date" class="nowrap">
                  <span class="cell-sub"><%= new Date(notification.createdAt).toLocaleString() %></span>
                </td>
                <td data-label="Message">
                  <% if (notification.link) { %>
                    <a href="<%= notification.link %>"><%= notification.message %></a>
                  <% } else { %>
                    <%= notification.message %>
                  <% } %>
                </td>
                <td data-label="Status">
                  <span class="pill <%= notification.status %>">
                    <%= notification.status.charAt(0).toUpperCase() + notification.status.slice(1) %>
                  </span>
                </td>
                <td data-label="Action" class="actions">
                  <% if (notification.status === 'unread') { %>
                    <form class="inline-form" action="/notifications/read/<%= notification._id %>" method="POST">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                      <button type="submit" class="btn btn-secondary btn-sm">Mark as read</button>
                    </form>
                  <% } else { %>
                    <span class="text-muted">—</span>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <%- include('partials/_pagination', { pagination }) %>
</main>

<%- include('partials/footer') %>
