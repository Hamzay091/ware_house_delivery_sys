<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main id="main-content">
  <div class="page-head">
    <div class="page-head__text">
      <h1 style="font-size: 1.75rem;">Dispatch hub</h1>
      <p>
        <% if (isAdminView) { %>
          Viewing the manager dashboard as an admin.
        <% } else { %>
          Assign, track and invoice every delivery in the system.
        <% } %>
      </p>
    </div>
    <div class="page-head__actions">
      <a class="btn btn-secondary" href="/inventory">
        <i class="fa-solid fa-boxes-stacked" aria-hidden="true"></i> Inventory
      </a>
      <a class="btn btn-secondary" href="/delivery-reports">
        <i class="fa-solid fa-chart-column" aria-hidden="true"></i> Reports
      </a>
      <a class="btn btn-secondary" href="/view-messages">
        <i class="fa-solid fa-inbox" aria-hidden="true"></i> Messages<% if (unreadMessageCount > 0) { %>
          <span class="badge"><%= unreadMessageCount %></span>
        <% } %>
      </a>
      <a class="btn btn-primary" href="/deliveries/assign">
        <i class="fa-solid fa-plus" aria-hidden="true"></i> Assign delivery
      </a>
    </div>
  </div>

  <%- include('partials/_notifications') %>

  <div class="stats mb-5">
    <% statuses.forEach(status => {
         const key = status.toLowerCase().replace(' ', '-');
         const icons = {
           'pending': 'fa-clock',
           'in-transit': 'fa-truck-fast',
           'delivered': 'fa-circle-check',
           'failed': 'fa-circle-xmark'
         };
         const tones = {
           'pending': 'stat__icon--warn',
           'in-transit': 'stat__icon--info',
           'delivered': 'stat__icon--ok',
           'failed': 'stat__icon--danger'
         };
    %>
      <div class="stat">
        <div class="stat__icon <%= tones[key] %>">
          <i class="fa-solid <%= icons[key] %>" aria-hidden="true"></i>
        </div>
        <div>
          <div class="stat__label"><%= status %></div>
          <div class="stat__value"><%= statusCounts[status] %></div>
        </div>
      </div>
    <% }) %>
  </div>

  <div class="toolbar">
    <form class="filters" action="/manager-dashboard" method="GET" role="search">
      <div class="search-field">
        <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
        <label class="sr-only" for="search">Search deliveries</label>
        <input type="search" id="search" name="search" data-autosubmit
               value="<%= filters.search %>" placeholder="Search address or staff..." />
      </div>

      <label class="sr-only" for="status">Filter by status</label>
      <select id="status" name="status" data-autosubmit>
        <option value="">All statuses</option>
        <% statuses.forEach(status => { %>
          <option value="<%= status %>" <%= filters.status === status ? 'selected' : '' %>><%= status %></option>
        <% }) %>
      </select>

      <noscript><button class="btn btn-secondary" type="submit">Filter</button></noscript>
    </form>
  </div>

  <div class="table-container">
    <div class="table-scroll">
      <table class="responsive">
        <thead>
          <tr>
            <th scope="col">Destination</th>
            <th scope="col">Items</th>
            <th scope="col">Assigned to</th>
            <th scope="col">Status</th>
            <th scope="col">Updated</th>
            <th scope="col">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (deliveries.length === 0) { %>
            <tr>
              <td colspan="6">
                <div class="empty">
                  <div class="empty__icon"><i class="fa-solid fa-inbox" aria-hidden="true"></i></div>
                  <div class="empty__title">No deliveries match</div>
                  <p>
                    <% if (filters.search || filters.status) { %>
                      Try clearing the filters, or assign a new delivery.
                    <% } else { %>
                      Assign your first delivery to get started.
                    <% } %>
                  </p>
                  <a class="btn btn-primary" href="/deliveries/assign">Assign a delivery</a>
                </div>
              </td>
            </tr>
          <% } else { %>
            <% deliveries.forEach(delivery => { %>
              <tr>
                <td data-label="Destination">
                  <span class="cell-title"><%= delivery.customerAddress %></span>
                </td>
                <td data-label="Items">
                  <% if (delivery.items && delivery.items.length > 0) { %>
                    <ul class="item-list">
                      <% delivery.items.forEach(line => { %>
                        <li>
                          <span class="qty"><%= line.quantity %>&times;</span>
                          <% if (line.itemId) { %>
                            <%= line.itemId.name %> <span class="cell-sub">(<%= line.itemId.sku %>)</span>
                          <% } else { %>
                            <em class="text-danger">deleted item</em>
                          <% } %>
                        </li>
                      <% }) %>
                    </ul>
                  <% } else { %>
                    <span class="text-muted">No items</span>
                  <% } %>
                </td>
                <td data-label="Assigned to"><%= delivery.assignedTo %></td>
                <td data-label="Status">
                  <span class="pill <%= delivery.status.toLowerCase().replace(' ', '-') %>"><%= delivery.status %></span>
                </td>
                <td data-label="Updated" class="nowrap">
                  <span class="cell-sub"><%= new Date(delivery.updatedAt).toLocaleDateString() %></span>
                </td>
                <td data-label="Actions" class="actions">
                  <div class="btn-group">
                    <% if (delivery.status === 'Pending' || delivery.status === 'In Transit') { %>
                      <a href="/ai/optimize-delivery-route/<%= delivery._id %>" class="btn btn-secondary btn-sm">
                        <i class="fa-solid fa-route" aria-hidden="true"></i> Route
                      </a>
                    <% } %>
                    <% if (delivery.status === 'Delivered') { %>
                      <% if (invoicedIds.has(String(delivery._id))) { %>
                        <span class="pill paid pill--plain">Invoiced</span>
                      <% } else { %>
                        <form class="inline-form" action="/billing/generate/<%= delivery._id %>" method="POST">
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                          <button type="submit" class="btn btn-success btn-sm">
                            <i class="fa-solid fa-file-invoice-dollar" aria-hidden="true"></i> Invoice
                          </button>
                        </form>
                      <% } %>
                    <% } %>
                  </div>
                </td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <%- include('partials/_pagination', { pagination }) %>
</main>

<%- include('partials/footer') %>
