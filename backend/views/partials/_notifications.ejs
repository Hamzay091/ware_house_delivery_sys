<% if (locals.notifications && notifications.length > 0) { %>
  <div class="card mb-5">
    <div class="card__header">
      <h3><i class="fa-solid fa-bell" style="color: var(--warn);" aria-hidden="true"></i> Unread alerts</h3>
      <a class="btn btn-ghost btn-sm" href="/notifications">View all</a>
    </div>
    <ul class="notice-list">
      <% notifications.slice(0, 5).forEach(notification => { %>
        <li class="notice">
          <div class="notice__body">
            <% if (notification.link) { %>
              <a class="notice__msg" href="<%= notification.link %>"><%= notification.message %></a>
            <% } else { %>
              <span class="notice__msg"><%= notification.message %></span>
            <% } %>
            <span class="notice__time"><%= new Date(notification.createdAt).toLocaleString() %></span>
          </div>
          <form class="inline-form" action="/notifications/read/<%= notification._id %>" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <button class="icon-btn" type="submit" title="Mark as read" aria-label="Mark as read">
              <i class="fa-solid fa-check" aria-hidden="true"></i>
            </button>
          </form>
        </li>
      <% }) %>
    </ul>
  </div>
<% } %>
