<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main id="main-content">
  <div class="form-card">
    <h1 style="font-size: 1.6rem;">Welcome, <%= name %></h1>
    <p class="form-card__intro">
      One more step — tell us what you do, so we can show you the right tools.
    </p>

    <div class="alert alert--info">
      <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
      <p>An administrator reviews new accounts, so you will not be able to sign in straight away.</p>
    </div>

    <form action="/choose-role" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

      <div class="field">
        <%# Admin is deliberately absent: it cannot be self-assigned here. %>
        <label for="role">Your role</label>
        <select id="role" name="role" required>
          <option value="">Select a role</option>
          <option value="Manager">Manager — inventory, dispatch and billing</option>
          <option value="DeliveryStaff">Delivery staff — my assigned deliveries</option>
        </select>
      </div>

      <button type="submit" class="btn btn-primary btn-block">Request access</button>
    </form>
  </div>
</main>

<%- include('partials/footer') %>
