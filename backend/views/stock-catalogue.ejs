<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main id="main-content">
  <div class="page-head">
    <div class="page-head__text">
      <h1 style="font-size: 1.75rem;">Stock catalogue</h1>
      <p>A read-only view of what is on the shelves right now.</p>
    </div>
  </div>

  <div class="toolbar">
    <form class="filters" action="/stock" method="GET" role="search">
      <div class="search-field">
        <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
        <label class="sr-only" for="search">Search the catalogue</label>
        <input type="search" id="search" name="search" data-autosubmit
               value="<%= filters.search %>" placeholder="Search name, SKU or location..." />
      </div>

      <label class="sr-only" for="availability">Filter by availability</label>
      <select id="availability" name="availability" data-autosubmit>
        <option value="">All items</option>
        <option value="in" <%= filters.availability === 'in' ? 'selected' : '' %>>In stock</option>
        <option value="out" <%= filters.availability === 'out' ? 'selected' : '' %>>Out of stock</option>
      </select>

      <noscript><button class="btn btn-secondary" type="submit">Filter</button></noscript>
    </form>
  </div>

  <% if (items.length === 0) { %>
    <div class="card">
      <div class="empty">
        <div class="empty__icon"><i class="fa-solid fa-warehouse" aria-hidden="true"></i></div>
        <div class="empty__title">Nothing to show</div>
        <p>
          <% if (filters.search || filters.availability) { %>
            No items match your search.
          <% } else { %>
            The warehouse catalogue is empty.
          <% } %>
        </p>
      </div>
    </div>
  <% } else { %>
    <div class="catalogue">
      <% items.forEach(item => { %>
        <article class="catalogue__card">
          <h3 style="font-size: 1.05rem;"><%= item.name %></h3>
          <span class="catalogue__sku"><%= item.sku %></span>
          <p style="font-size: 0.88rem; margin: 0;">
            <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
            <%= item.location || 'Location not set' %>
          </p>

          <div class="catalogue__foot">
            <% if (item.availableStock > 0) { %>
              <span class="pill delivered"><%= item.availableStock %> in stock</span>
            <% } else { %>
              <span class="pill failed">Out of stock</span>
            <% } %>
            <span class="cell-sub">$<%= (item.price || 0).toFixed(2) %></span>
          </div>
        </article>
      <% }) %>
    </div>
  <% } %>
</main>

<%- include('partials/footer') %>
