<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main id="main-content">
  <div class="form-card">
    <h1 style="font-size: 1.75rem;">Create your account</h1>
    <p class="form-card__intro">Set up access to the Apex Logistics workspace.</p>

    <%- include('partials/_form-errors', { errors }) %>

    <form id="register-form" action="/register" method="POST" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

      <div class="field">
        <label for="name">Full name</label>
        <input type="text" id="name" name="name" autocomplete="name"
               value="<%= values.name || '' %>" placeholder="e.g. Jane Smith" required />
      </div>

      <div class="field">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" autocomplete="email"
               value="<%= values.email || '' %>" placeholder="you@example.com" required />
      </div>

      <div class="field">
        <label for="password">Password</label>
        <input type="password" id="password" name="password" autocomplete="new-password"
               minlength="8" placeholder="At least 8 characters" required />
        <p class="field__hint">Use at least 8 characters.</p>
      </div>

      <div class="field">
        <label for="role">Role</label>
        <select id="role" name="role" required>
          <option value="">Select a role</option>
          <option value="Admin" <%= values.role === 'Admin' ? 'selected' : '' %>>Admin</option>
          <option value="Manager" <%= values.role === 'Manager' ? 'selected' : '' %>>Manager</option>
          <option value="DeliveryStaff" <%= values.role === 'DeliveryStaff' ? 'selected' : '' %>>Delivery staff</option>
        </select>
      </div>

      <div class="field">
        <label for="localPhone">Phone number <span class="text-muted">(optional)</span></label>
        <div style="display: grid; grid-template-columns: 140px minmax(0, 1fr); gap: var(--sp-3);">
          <select id="countryCode" name="countryCode" aria-label="Country code">
            <option value="+92">+92 (PK)</option>
            <option value="+1">+1 (US)</option>
            <option value="+44">+44 (UK)</option>
            <option value="+91">+91 (IN)</option>
            <option value="+971">+971 (AE)</option>
          </select>
          <input type="tel" id="localPhone" autocomplete="tel-national" placeholder="300 1234567" />
        </div>
        <%# The two controls above are combined into this hidden field on submit. %>
        <input type="hidden" id="phone" name="phone" value="<%= values.phone || '' %>" />
      </div>

      <div class="field">
        <label for="socialLink">Social profile link <span class="text-muted">(optional)</span></label>
        <input type="url" id="socialLink" name="socialLink"
               value="<%= values.socialLink || '' %>" placeholder="https://..." />
      </div>

      <div class="field">
        <label for="gender">Gender <span class="text-muted">(optional)</span></label>
        <select id="gender" name="gender">
          <option value="">Prefer not to say</option>
          <option value="Male" <%= values.gender === 'Male' ? 'selected' : '' %>>Male</option>
          <option value="Female" <%= values.gender === 'Female' ? 'selected' : '' %>>Female</option>
          <option value="Other" <%= values.gender === 'Other' ? 'selected' : '' %>>Other</option>
        </select>
      </div>

      <button type="submit" class="btn btn-primary btn-block">Create account</button>

      <p class="text-center" style="margin-top: var(--sp-5); font-size: 0.92rem;">
        Already registered? <a href="/login">Log in</a>
      </p>
    </form>
  </div>
</main>

<script nonce="<%= cspNonce %>">
  // Combine the country code and the local number into the single `phone`
  // field the server stores. Without JS the hidden field simply stays empty,
  // and the phone number is optional, so registration still works.
  (function () {
    var form = document.getElementById('register-form');
    if (!form) return;

    form.addEventListener('submit', function () {
      var code = document.getElementById('countryCode').value;
      var local = document.getElementById('localPhone').value.trim();
      var target = document.getElementById('phone');
      target.value = local ? code + local.replace(/^0+/, '').replace(/\s+/g, '') : '';
    });
  })();
</script>

<%- include('partials/footer') %>
