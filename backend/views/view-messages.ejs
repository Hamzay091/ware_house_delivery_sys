<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main id="main-content">
  <div class="page-head">
    <div class="page-head__text">
      <h1 style="font-size: 1.75rem;">Contact messages</h1>
      <p>
        Everything submitted through the public contact form.
        <% if (unreadMessageCount > 0) { %>
          <strong><%= unreadMessageCount %></strong> unread.
        <% } %>
      </p>
    </div>
    <% if (unreadMessageCount > 0) { %>
      <div class="page-head__actions">
        <form class="inline-form" action="/messages/read-all" method="POST">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <button type="submit" class="btn btn-secondary">
            <i class="fa-solid fa-check-double" aria-hidden="true"></i> Mark all as read
          </button>
        </form>
      </div>
    <% } %>
  </div>

  <div class="toolbar">
    <form class="filters" action="/view-messages" method="GET" role="search">
      <div class="search-field">
        <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
        <label class="sr-only" for="search">Search messages</label>
        <input type="search" id="search" name="search" data-autosubmit
               value="<%= filters.search %>" placeholder="Search name, email or message..." />
      </div>
      <noscript><button class="btn btn-secondary" type="submit">Search</button></noscript>
    </form>
  </div>

  <div class="table-container">
    <div class="table-scroll">
      <table class="responsive">
        <thead>
          <tr>
            <th scope="col">Received</th>
            <th scope="col">From</th>
            <th scope="col">Email</th>
            <th scope="col">Message</th>
            <th scope="col">Status</th>
            <th scope="col">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (messages.length === 0) { %>
            <tr>
              <td colspan="6">
                <div class="empty">
                  <div class="empty__icon"><i class="fa-solid fa-envelope-open" aria-hidden="true"></i></div>
                  <div class="empty__title">No messages</div>
                  <p>Enquiries from the landing page will land here.</p>
                </div>
              </td>
            </tr>
          <% } else { %>
            <% messages.forEach(msg => { %>
              <tr>
                <td data-label="Received" class="nowrap">
                  <span class="cell-sub"><%= new Date(msg.createdAt).toLocaleString() %></span>
                </td>
                <td data-label="From"><span class="cell-title"><%= msg.name %></span></td>
                <td data-label="Email"><a href="mailto:<%= msg.email %>"><%= msg.email %></a></td>
                <td data-label="Message" style="max-width: 460px; white-space: pre-wrap;"><%= msg.message %></td>
                <td data-label="Status">
                  <span class="pill <%= msg.status === 'New' ? 'unread' : 'read' %>"><%= msg.status %></span>
                </td>
                <td data-label="Actions" class="actions">
                  <% if (msg.status === 'New') { %>
                    <form class="inline-form" action="/messages/read/<%= msg._id %>" method="POST">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                      <button type="submit" class="btn btn-secondary btn-sm">Mark as read</button>
                    </form>
                  <% } else { %>
                    <span class="text-muted">—</span>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <%- include('partials/_pagination', { pagination }) %>
</main>

<%- include('partials/footer') %>
