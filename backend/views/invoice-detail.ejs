<%- include('partials/header') %>
<%- include('partials/navbar') %>
<%
  const delivery = invoice.deliveryId;
  const lines = (delivery && delivery.items) ? delivery.items : [];
  const reference = invoice._id.toString().slice(-8).toUpperCase();
%>

<main id="main-content">
  <div class="page-head">
    <div class="page-head__text">
      <h1 style="font-size: 1.5rem;">Invoice <%= reference %></h1>
    </div>
    <div class="page-head__actions">
      <a class="btn btn-secondary" href="/billing/invoices">
        <i class="fa-solid fa-arrow-left" aria-hidden="true"></i> All invoices
      </a>
      <% if (invoice.status === 'Unpaid') { %>
        <form class="inline-form" action="/billing/update-status/<%= invoice._id %>" method="POST">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <input type="hidden" name="status" value="Paid" />
          <input type="hidden" name="redirectTo" value="detail" />
          <button type="submit" class="btn btn-success">Mark as paid</button>
        </form>
      <% } %>
    </div>
  </div>

  <div class="invoice">
    <div class="invoice__header">
      <div>
        <h1>Invoice</h1>
        <p>Apex Logistics</p>
      </div>
      <div class="text-right">
        <p style="font-family: var(--font-mono);">#<%= reference %></p>
        <p><%= new Date(invoice.invoiceDate).toLocaleDateString() %></p>
      </div>
    </div>

    <div class="invoice__body">
      <div class="invoice__meta">
        <div>
          <h4>Delivered to</h4>
          <p><%= invoice.customerAddress %></p>
        </div>
        <div>
          <h4>Delivered by</h4>
          <p><%= delivery ? delivery.assignedTo : 'Unknown' %></p>
        </div>
        <div>
          <h4>Status</h4>
          <p><span class="pill <%= invoice.status.toLowerCase() %>"><%= invoice.status %></span></p>
        </div>
      </div>

      <div class="table-scroll">
        <table>
          <thead>
            <tr>
              <th scope="col">Item</th>
              <th scope="col" class="text-right">Unit price</th>
              <th scope="col" class="text-right">Qty</th>
              <th scope="col" class="text-right">Total</th>
            </tr>
          </thead>
          <tbody>
            <% if (lines.length === 0) { %>
              <tr><td colspan="4" class="text-muted text-center">No line items recorded.</td></tr>
            <% } else { %>
              <% lines.forEach(line => {
                   const item = line.itemId;
                   const price = item ? item.price : 0;
              %>
                <tr>
                  <td>
                    <% if (item) { %>
                      <div class="cell-title"><%= item.name %></div>
                      <div class="cell-sub mono">SKU: <%= item.sku %></div>
                    <% } else { %>
                      <div class="cell-title text-danger"><em>Item no longer in catalogue</em></div>
                    <% } %>
                  </td>
                  <td class="num">$<%= price.toFixed(2) %></td>
                  <td class="num"><%= line.quantity %></td>
                  <td class="num">$<%= (price * line.quantity).toFixed(2) %></td>
                </tr>
              <% }) %>
            <% } %>
          </tbody>
        </table>
      </div>

      <div class="invoice__totals">
        <table>
          <tbody>
            <tr>
              <td>Subtotal</td>
              <td class="text-right">$<%= invoice.totalAmount.toFixed(2) %></td>
            </tr>
            <tr class="total">
              <td>Total</td>
              <td class="text-right">$<%= invoice.totalAmount.toFixed(2) %></td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="invoice__footer">
        <p>Thank you for your business.</p>
      </div>
    </div>

    <div class="invoice__actions">
      <button type="button" class="btn btn-primary" data-print>
        <i class="fa-solid fa-print" aria-hidden="true"></i> Print invoice
      </button>
    </div>
  </div>
</main>

<script nonce="<%= cspNonce %>">
  document.querySelector('[data-print]').addEventListener('click', () => window.print());
</script>

<%- include('partials/footer') %>
