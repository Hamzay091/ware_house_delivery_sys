<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main id="main-content">
  <div class="form-card">
    <h1 style="font-size: 1.75rem;">Welcome back</h1>
    <p class="form-card__intro">Sign in to manage inventory, deliveries and billing.</p>

    <%- include('partials/_form-errors', { errors }) %>

    <form action="/login" method="POST" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

      <div class="field">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" autocomplete="email"
               value="<%= values.email || '' %>" placeholder="you@example.com" required />
      </div>

      <div class="field">
        <label for="password">Password</label>
        <input type="password" id="password" name="password"
               autocomplete="current-password" placeholder="••••••••" required />
      </div>

      <button type="submit" class="btn btn-primary btn-block">Log in</button>

      <% if (googleAuthEnabled) { %>
        <div class="divider">or</div>
        <a href="/auth/google" class="btn btn-secondary btn-block">
          <svg width="18" height="18" viewBox="0 0 48 48" aria-hidden="true">
            <path fill="#FFC107" d="M43.6 20.1H42V20H24v8h11.3C33.7 32.7 29.3 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.9 1.2 8 3.1l5.7-5.7C34.0 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.6-.4-3.9z"/>
            <path fill="#FF3D00" d="m6.3 14.7 6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.9 1.2 8 3.1l5.7-5.7C34.0 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/>
            <path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.1 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-7.9l-6.5 5C9.5 39.6 16.2 44 24 44z"/>
            <path fill="#1976D2" d="M43.6 20.1H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 40.2 44 35 44 24c0-1.3-.1-2.6-.4-3.9z"/>
          </svg>
          Continue with Google
        </a>
      <% } %>

      <p class="text-center" style="margin-top: var(--sp-5); font-size: 0.92rem;">
        Don't have an account? <a href="/register">Create one</a>
      </p>
    </form>
  </div>
</main>

<%- include('partials/footer') %>
