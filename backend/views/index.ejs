<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main id="main-content" class="main--flush">

  <section class="hero">
    <div class="hero__inner">
      <span class="hero__eyebrow">
        <i class="fa-solid fa-bolt" aria-hidden="true"></i> AI-assisted logistics
      </span>
      <h1>Run the warehouse, <em>not the spreadsheet</em></h1>
      <p class="hero__lede">
        Apex Logistics joins inventory, dispatch and billing into one system —
        with stock forecasting, workload-balanced assignment and route
        optimisation doing the arithmetic for you.
      </p>
      <div class="hero__cta">
        <a href="/register" class="btn btn-primary btn-lg">Get started</a>
        <a href="#features" class="btn btn-secondary btn-lg">See how it works</a>
      </div>

      <div class="hero__stats">
        <div>
          <div class="hero__stat-value"><%= highlights.items.toLocaleString() %></div>
          <div class="hero__stat-label">Items tracked</div>
        </div>
        <div>
          <div class="hero__stat-value"><%= highlights.deliveries.toLocaleString() %></div>
          <div class="hero__stat-label">Deliveries logged</div>
        </div>
        <div>
          <div class="hero__stat-value"><%= highlights.staff.toLocaleString() %></div>
          <div class="hero__stat-label">Drivers on the roster</div>
        </div>
      </div>
    </div>
  </section>

  <div style="max-width: var(--shell-max); margin: 0 auto; padding: 0 var(--sp-5);">

    <section id="features" class="landing-section reveal" style="scroll-margin-top: 90px;">
      <div class="section-head">
        <h2>Built for the people doing the work</h2>
        <p>
          Every role gets the view it needs — and the system keeps the numbers
          honest underneath.
        </p>
      </div>

      <div class="features">
        <article class="feature">
          <div class="feature__icon"><i class="fa-solid fa-chart-line" aria-hidden="true"></i></div>
          <h3>Predictive stock forecasting</h3>
          <p>
            A daily burn rate from the last 30 days of completed deliveries tells
            you how long each SKU will last, so reordering stops being a guess.
          </p>
        </article>

        <article class="feature">
          <div class="feature__icon"><i class="fa-solid fa-route" aria-hidden="true"></i></div>
          <h3>Route optimisation</h3>
          <p>
            Delivery addresses are geocoded and ordered into an efficient run,
            plotted on a live map before the van leaves the yard.
          </p>
        </article>

        <article class="feature">
          <div class="feature__icon"><i class="fa-solid fa-scale-balanced" aria-hidden="true"></i></div>
          <h3>Balanced assignment</h3>
          <p>
            New jobs are suggested to whoever has the lightest active workload,
            so nobody ends the week with twice everyone else's runs.
          </p>
        </article>

        <article class="feature">
          <div class="feature__icon"><i class="fa-solid fa-boxes-stacked" aria-hidden="true"></i></div>
          <h3>Stock that cannot go negative</h3>
          <p>
            Reservations are atomic: two managers claiming the last units at the
            same moment cannot both succeed, and failed runs return their stock.
          </p>
        </article>

        <article class="feature">
          <div class="feature__icon"><i class="fa-solid fa-file-invoice-dollar" aria-hidden="true"></i></div>
          <h3>Invoicing from real deliveries</h3>
          <p>
            Completed runs become itemised invoices in one click, tracked from
            unpaid to paid and printable straight from the browser.
          </p>
        </article>

        <article class="feature">
          <div class="feature__icon"><i class="fa-solid fa-bell" aria-hidden="true"></i></div>
          <h3>Alerts before it hurts</h3>
          <p>
            Crossing the low-stock threshold notifies every manager in-app and by
            email, while the item still has time to be reordered.
          </p>
        </article>
      </div>
    </section>

    <section id="contact" class="landing-section reveal" style="scroll-margin-top: 90px;">
      <div class="section-head">
        <h2>Ready to take a look?</h2>
        <p>Send us a note and we will get back to you with a walkthrough.</p>
      </div>

      <div class="form-card">
        <%- include('partials/_form-errors', { errors }) %>

        <form action="/" method="POST" novalidate>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

          <div class="field">
            <label for="name">Your name</label>
            <input type="text" id="name" name="name" autocomplete="name"
                   value="<%= values.name || '' %>" placeholder="e.g. Jane Smith" required />
          </div>

          <div class="field">
            <label for="email">Your email</label>
            <input type="email" id="email" name="email" autocomplete="email"
                   value="<%= values.email || '' %>" placeholder="you@example.com" required />
          </div>

          <div class="field">
            <label for="message">Your message</label>
            <textarea id="message" name="message" rows="5"
                      placeholder="Tell us a little about your operation..." required><%= values.message || '' %></textarea>
          </div>

          <button type="submit" class="btn btn-primary btn-block">Send message</button>
        </form>
      </div>
    </section>

  </div>
</main>

<%- include('partials/footer') %>
