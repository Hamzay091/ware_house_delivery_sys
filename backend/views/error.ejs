<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main id="main-content">
  <div class="card text-center" style="max-width: 560px; margin: var(--sp-7) auto;">
    <div class="empty">
      <div class="empty__icon">
        <i class="fa-solid <%= status === 404 ? 'fa-map-location-dot' : (status === 403 ? 'fa-lock' : 'fa-triangle-exclamation') %>" aria-hidden="true"></i>
      </div>
      <p class="text-muted" style="font-size: 0.8rem; letter-spacing: 0.1em; text-transform: uppercase;">
        Error <%= status %>
      </p>
      <h1 style="font-size: 1.6rem; margin-bottom: var(--sp-3);"><%= heading %></h1>
      <p><%= detail %></p>
      <div class="btn-group" style="justify-content: center;">
        <a class="btn btn-primary" href="/">Back to home</a>
        <% if (user) { %>
          <a class="btn btn-secondary" href="<%= user.role === 'Admin' ? '/admin-dashboard' : (user.role === 'Manager' ? '/manager-dashboard' : '/delivery-staff-dashboard') %>">
            My dashboard
          </a>
        <% } else { %>
          <a class="btn btn-secondary" href="/login">Log in</a>
        <% } %>
      </div>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
