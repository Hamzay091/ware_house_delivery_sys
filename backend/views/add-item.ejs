<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main id="main-content">
  <div class="form-card">
    <h1 style="font-size: 1.6rem;">Add or restock an item</h1>
    <p class="form-card__intro">
      Restocking adds to an existing SKU; a new SKU creates a new item.
    </p>

    <%- include('partials/_form-errors', { errors }) %>

    <form action="/inventory/add" method="POST" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

      <div class="field">
        <label for="stockId">Existing category</label>
        <select id="stockId" name="stockId">
          <option value="">Choose an existing category</option>
          <% stocks.forEach(stock => { %>
            <option value="<%= stock._id %>" <%= values.stockId === String(stock._id) ? 'selected' : '' %>>
              <%= stock.name %>
            </option>
          <% }) %>
        </select>
        <p class="field__hint">Leave blank if you are creating a new category below.</p>
      </div>

      <div class="divider">or</div>

      <div class="field">
        <label for="newStockName">New category name</label>
        <input type="text" id="newStockName" name="newStockName"
               value="<%= values.newStockName || '' %>" placeholder="e.g. Gaming headsets" />
      </div>

      <hr />

      <div class="field">
        <label for="sku">SKU <span class="text-muted">(unique within the category)</span></label>
        <input type="text" id="sku" name="sku" value="<%= values.sku || '' %>"
               placeholder="e.g. RAZER-KRAKEN-V3" required />
      </div>

      <div class="field">
        <label for="price">Unit price</label>
        <input type="number" id="price" name="price" value="<%= values.price || '0.00' %>"
               min="0" step="0.01" required />
      </div>

      <div class="field">
        <label for="quantity">Quantity to add</label>
        <input type="number" id="quantity" name="quantity" value="<%= values.quantity || '1' %>"
               min="0" step="1" required />
      </div>

      <div class="field">
        <label for="location">Warehouse location <span class="text-muted">(optional)</span></label>
        <input type="text" id="location" name="location" value="<%= values.location || '' %>"
               placeholder="e.g. Aisle 7, Shelf B" />
      </div>

      <div class="btn-group" style="width: 100%;">
        <button type="submit" class="btn btn-primary" style="flex: 1;">Save item</button>
        <a href="/inventory" class="btn btn-secondary">Cancel</a>
      </div>
    </form>
  </div>
</main>

<%- include('partials/footer') %>
