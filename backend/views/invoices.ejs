<%- include('partials/header') %>
<%- include('partials/navbar') %>
<%
  const sortIcon = (field) => {
    if (sort.field !== field) return 'fa-sort';
    return sort.dir === 'asc' ? 'fa-sort-up' : 'fa-sort-down';
  };
%>

<main id="main-content">
  <div class="page-head">
    <div class="page-head__text">
      <h1 style="font-size: 1.75rem;">Billing</h1>
      <p>Invoices generated from completed deliveries.</p>
    </div>
    <div class="page-head__actions">
      <a class="btn btn-secondary" href="/billing/invoices/export.csv?<%= pagination.baseQuery %>">
        <i class="fa-solid fa-file-csv" aria-hidden="true"></i> Export CSV
      </a>
    </div>
  </div>

  <div class="stats mb-5">
    <div class="stat">
      <div class="stat__icon stat__icon--warn"><i class="fa-solid fa-hourglass-half" aria-hidden="true"></i></div>
      <div>
        <div class="stat__label">Outstanding</div>
        <div class="stat__value">$<%= summary.outstanding.toFixed(2) %></div>
        <div class="stat__meta"><%= summary.Unpaid %> unpaid invoice(s)</div>
      </div>
    </div>
    <div class="stat">
      <div class="stat__icon stat__icon--ok"><i class="fa-solid fa-sack-dollar" aria-hidden="true"></i></div>
      <div>
        <div class="stat__label">Collected</div>
        <div class="stat__value">$<%= summary.collected.toFixed(2) %></div>
        <div class="stat__meta"><%= summary.Paid %> paid invoice(s)</div>
      </div>
    </div>
    <div class="stat">
      <div class="stat__icon"><i class="fa-solid fa-file-invoice" aria-hidden="true"></i></div>
      <div>
        <div class="stat__label">Total invoices</div>
        <div class="stat__value"><%= summary.Unpaid + summary.Paid + summary.Void %></div>
        <div class="stat__meta"><%= summary.Void %> void</div>
      </div>
    </div>
  </div>

  <div class="toolbar">
    <form class="filters" action="/billing/invoices" method="GET" role="search">
      <div class="search-field">
        <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
        <label class="sr-only" for="search">Search invoices</label>
        <input type="search" id="search" name="search" data-autosubmit
               value="<%= filters.search %>" placeholder="Search customer address..." />
      </div>

      <label class="sr-only" for="status">Filter by status</label>
      <select id="status" name="status" data-autosubmit>
        <option value="">All statuses</option>
        <option value="Unpaid" <%= filters.status === 'Unpaid' ? 'selected' : '' %>>Unpaid</option>
        <option value="Paid" <%= filters.status === 'Paid' ? 'selected' : '' %>>Paid</option>
        <option value="Void" <%= filters.status === 'Void' ? 'selected' : '' %>>Void</option>
      </select>

      <noscript><button class="btn btn-secondary" type="submit">Filter</button></noscript>
    </form>
  </div>

  <div class="table-container">
    <div class="table-scroll">
      <table class="responsive">
        <thead>
          <tr>
            <th scope="col"><a href="<%= sortHref('invoiceDate') %>">Date <i class="fa-solid <%= sortIcon('invoiceDate') %> sort-ind" aria-hidden="true"></i></a></th>
            <th scope="col">Customer address</th>
            <th scope="col"><a href="<%= sortHref('totalAmount') %>">Amount <i class="fa-solid <%= sortIcon('totalAmount') %> sort-ind" aria-hidden="true"></i></a></th>
            <th scope="col"><a href="<%= sortHref('status') %>">Status <i class="fa-solid <%= sortIcon('status') %> sort-ind" aria-hidden="true"></i></a></th>
            <th scope="col">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (invoices.length === 0) { %>
            <tr>
              <td colspan="5">
                <div class="empty">
                  <div class="empty__icon"><i class="fa-solid fa-file-invoice" aria-hidden="true"></i></div>
                  <div class="empty__title">No invoices yet</div>
                  <p>Invoices appear here once a delivery is marked as delivered and invoiced.</p>
                  <a class="btn btn-primary" href="/manager-dashboard">Go to dispatch</a>
                </div>
              </td>
            </tr>
          <% } else { %>
            <% invoices.forEach(invoice => { %>
              <tr>
                <td data-label="Date" class="nowrap"><%= new Date(invoice.invoiceDate).toLocaleDateString() %></td>
                <td data-label="Customer address"><span class="cell-title"><%= invoice.customerAddress %></span></td>
                <td data-label="Amount" class="num">$<%= invoice.totalAmount.toFixed(2) %></td>
                <td data-label="Status">
                  <span class="pill <%= invoice.status.toLowerCase() %>"><%= invoice.status %></span>
                </td>
                <td data-label="Actions" class="actions">
                  <div class="btn-group">
                    <a href="/billing/invoice/<%= invoice._id %>" class="btn btn-secondary btn-sm">View</a>
                    <% if (invoice.status === 'Unpaid') { %>
                      <form class="inline-form" action="/billing/update-status/<%= invoice._id %>" method="POST">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                        <input type="hidden" name="status" value="Paid" />
                        <button type="submit" class="btn btn-success btn-sm">Mark paid</button>
                      </form>
                    <% } %>
                  </div>
                </td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <%- include('partials/_pagination', { pagination }) %>
</main>

<%- include('partials/footer') %>
