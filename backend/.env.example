# Copy this file to .env and fill in real values. Never commit .env.

# --- Core -------------------------------------------------------------------
PORT=3000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/warehouseDB

# Signs the session cookie. Use a long random string, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SECRET_KEY=

# --- Google OAuth (optional) ------------------------------------------------
# Leave blank to disable the "Continue with Google" button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=/auth/google/callback

# --- Email notifications (optional) -----------------------------------------
# Leave blank to disable outgoing low-stock emails. For Gmail, use an
# app password rather than the account password.
EMAIL_USER=
EMAIL_PASS=

# --- Python AI service ------------------------------------------------------
AI_SERVICE_URL=http://127.0.0.1:5001
AI_TIMEOUT_MS=15000
WAREHOUSE_ORIGIN_ADDRESS=Jinnah Park, Gujranwala, Pakistan
